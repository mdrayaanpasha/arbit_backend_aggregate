# --- Shared by all 4 services ---
# Kafka broker host:port (managed Kafka, e.g. Aiven)
KAFKA_URL=your-kafka-host:port
# Redis connection URL
REDIS_URL=rediss://default:password@your-redis-host:port

# Kafka TLS client cert + key, base64-encoded (single line each).
# Generate on your machine:  base64 -w0 service.cert   (macOS: base64 -i service.cert)
SERVICE_CERT=base64-encoded-service-cert
SERVICE_KEY=base64-encoded-service-key

# --- FIN_PIP_SERVER_4 only (persistence) ---
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
