{
	# TLS is terminated at Cloudflare's edge and carried over the encrypted
	# tunnel, so Caddy just does internal HTTP host/path routing.
	auto_https off
}

# ---------- Quantiva (existing app) ----------
http://api-quantiva.rayaanpasha.dev {
	reverse_proxy quantiva_s1:3000
}

# ---------- ARBIT financial pipeline ----------
http://api-arbit.rayaanpasha.dev {
	handle /order* {
		reverse_proxy producer:3000
	}
	handle /anomalies* {
		reverse_proxy consumer:3001
	}
	handle /baseline* {
		reverse_proxy consumer:3001
	}
	handle /indicators* {
		reverse_proxy indicators:3002
	}
	handle /data* {
		reverse_proxy persistence:3003
	}
	handle {
		respond "ARBIT API — try /data, /indicators, /anomalies, /order" 200
	}
}
